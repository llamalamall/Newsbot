{
  "search_keywords_file": "search_keywords.json",
  "github_topics_file": "github_topics.json",
  "days_back": 7,
  "max_results_per_topic": 10,
  "github_enabled": true,
  "rss_enabled": true,
  "rss_feeds_file": "rss_feeds.json",
  "rss_settings": {
    "max_age_days": 7,
    "min_keyword_matches": 1,
    "cache_enabled": true,
    "cache_ttl_hours": 6,
    "request_timeout": 10,
    "max_feeds_parallel": 5,
    "rate_limit_delay": 0.5
  },
  "llm_assessment": {
    "enabled": true,
    "model": "gpt-4.1-mini",
    "applicability_threshold": 0.6,
    "credibility_threshold": 0.5,
    "filter_inapplicable": true,
    "filter_not_credible": true,
    "batch_size": 5
  },
  "skip_analyzed": {
    "enabled": true
  },
  "publish_docs": true
}
